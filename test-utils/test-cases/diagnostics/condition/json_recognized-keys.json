{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:RequestAlias": "alias/example",
          "aws:PrincipalOrgID": "o-example",
          "aws:PrincipalTag/department": "eng",
          "aws:ResourceTag/env": "prod"
        }
      }
    }
  ]
}
