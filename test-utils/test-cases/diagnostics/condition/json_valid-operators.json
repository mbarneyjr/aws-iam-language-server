---
code: INVALID_CONDITION_OPERATOR
count: 0
---
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "*",
      "Condition": {
        "Null": {
          "aws:PrincipalTag/department": "false"
        },
        "ArnNotLike": {
          "aws:PrincipalArn": "arn:aws:iam::123456789012:user/*"
        }
      }
    }
  ]
}
